# Shared ExaBGP 5.0.15 artifact; build with this directory as context.
FROM scratch AS source
# ExaBGP 5.0.15, peeled upstream tag commit and archive checksum.
ADD --checksum=sha256:d257c151ee3b3479d70c46c0de1561747b6e02d11d65d2abf0ea6f0acb93ce84 \
    https://codeload.github.com/Exa-Networks/exabgp/tar.gz/b70054ffdf210e3a6001e1dd282d08309d4552dd /exabgp.tar.gz

# Debian 13 (trixie-slim); only the approved external peer uses system Python.
FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/dantte-lp/gobfd" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="5.0.15" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.title="GoBFD ExaBGP interoperability peer" \
      org.opencontainers.image.description="Verified upstream ExaBGP module on Debian system Python" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim" \
      org.opencontainers.image.base.digest="sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad" \
      io.gobfd.upstream.revision="b70054ffdf210e3a6001e1dd282d08309d4552dd"

RUN ["apt-get", "update"]
RUN ["apt-get", "install", "-y", "--no-install-recommends", "python3", "iproute2", "dumb-init"]
RUN ["useradd", "-r", "exa"]
RUN ["install", "-d", "/opt/exabgp", "/etc/exabgp"]
RUN --mount=type=bind,from=source,target=/source \
    ["tar", "-xzf", "/source/exabgp.tar.gz", "-C", "/opt/exabgp", "--strip-components=1", "exabgp-b70054ffdf210e3a6001e1dd282d08309d4552dd/src", "exabgp-b70054ffdf210e3a6001e1dd282d08309d4552dd/LICENCE.txt"]
RUN ["mkfifo", "-m", "600", "/run/exabgp.in", "/run/exabgp.out"]
RUN ["chown", "exa", "/run/exabgp.in", "/run/exabgp.out"]

ENV PYTHONPATH=/opt/exabgp/src \
    exabgp_daemon_user=exa \
    exabgp_daemon_daemonize=false

# Consumers supply server/config arguments; no packaged default configuration.
ENTRYPOINT ["/usr/bin/dumb-init", "--", "python3", "-m", "exabgp"]
