# tshark container for BFD packet analysis in interoperability tests.
#
# Captures all BFD traffic (UDP 3784/3785/4784) on the shared bridge network
# and writes pcap files to /captures/ for offline analysis.
#
# tshark includes a built-in BFD dissector that decodes all RFC 5880 fields:
#   Version, Diagnostic, State, Flags (P/F/C/A/D/M),
#   Detect Mult, Length, My/Your Discriminator, intervals.

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/dantte-lp/gobfd" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VCS_REF}" \
      org.opencontainers.image.licenses="GPL-2.0-or-later" \
      org.opencontainers.image.title="GoBFD packet analysis fixture" \
      org.opencontainers.image.description="Debian TShark BFD capture and offline analysis" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim" \
      org.opencontainers.image.base.digest="sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       tshark \
    && rm -rf /var/lib/apt/lists/* \
    && mv /usr/bin/tshark /usr/bin/dumpcap /usr/local/bin/

# Ubuntu 26.04 AppArmor attaches its tshark profile to /usr/bin/tshark, and
# rootless Podman runs containers without a profile. Confined there, tshark
# cannot read /captures or receive container stop signals. tshark starts
# dumpcap from its own directory, so both binaries leave /usr/bin; PATH
# resolves tshark to /usr/local/bin.

RUN mkdir -p /captures

# Capture BFD control packets (port 3784), echo packets (port 3785), and
# multihop packets (port 4784) on all interfaces. Autostop after 100MB to
# prevent disk exhaustion.
ENTRYPOINT ["tshark", \
    "-i", "any", \
    "-f", "udp port 3784 or udp port 3785 or udp port 4784", \
    "-w", "/captures/bfd.pcapng", \
    "-a", "filesize:102400", \
    "-q"]
