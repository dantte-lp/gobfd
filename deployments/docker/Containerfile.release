FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

RUN groupadd -r gobfd && groupadd -r gobfd-admin \
    && useradd -r -g gobfd -G gobfd-admin -s /usr/sbin/nologin gobfd \
    && install -d -o gobfd -g gobfd -m 0755 /run/gobfd \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/gobfd \
     ${TARGETPLATFORM}/gobfdctl \
     ${TARGETPLATFORM}/gobfd-haproxy-agent \
     ${TARGETPLATFORM}/gobfd-exabgp-bridge \
     /usr/local/bin/

USER gobfd:gobfd

EXPOSE 3784/udp 4784/udp

ENTRYPOINT ["/usr/local/bin/gobfd"]
