# Echo reflector for RFC 9747 BFD echo interop testing.
# Listens on UDP 3785 and reflects packets back to the sender.
FROM docker.io/library/golang:1.27.3-trixie@sha256:604106102d33b1084e37ca08adf98ac0813624ae8595bd0d7f3965ecebded09c AS build
WORKDIR /src
RUN go mod init echo-reflector
COPY main.go .
RUN CGO_ENABLED=0 go build -o /echo-reflector .

FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
COPY --from=build /echo-reflector /usr/local/bin/echo-reflector
EXPOSE 3785/udp
ENTRYPOINT ["echo-reflector"]
