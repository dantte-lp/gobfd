# .containerignore -- build-context exclusions for Podman / Buildah.
# Spec: containers/common/docs/containerignore.5.md.
#
# Last matching rule wins. Use ! to negate an exclusion.

# VCS / IDE
.git
.gitattributes
.gitignore
.idea
.vscode
.worktrees
*.swp
*.swo
.DS_Store

# Local agent state
.agents
.codex
.claude

# Build / generated artifacts
bin/
dist/
build/
reports/
coverage.out
coverage.html
benchmark.txt
cpu.prof
mem.prof
*.test
*.prof
gobfd
gobfdctl
gobfd-haproxy-agent
gobfd-exabgp-bridge

# Runtime captures and benchmark outputs
bench-results/
testdata/benchmarks/
**/*.pcap
**/*.pcapng

# Local secrets / environment
.env
.env.*
*.pem
*.key
*.crt

# Tests, examples, and docs are not needed in production image contexts.
bench/
test/
testdata/
docs/
**/*.md
**/*.markdown

# The legacy-named BFD fuzz image builds its repository-owned Go command from
# the otherwise excluded test tree.
!test/
test/*
!test/interop/
test/interop/*
!test/interop/scapy/
test/interop/scapy/*
!test/interop/scapy/*.go

# The development-image Compose stage builds the repository-owned bootstrap
# command from the otherwise excluded test tree.
!test/cmd/
test/cmd/*
!test/cmd/toolbootstrap/
test/cmd/toolbootstrap/*
!test/cmd/toolbootstrap/*.go
!test/internal/
test/internal/*
!test/internal/toolbootstrap/
test/internal/toolbootstrap/*
!test/internal/toolbootstrap/*.go

# Container infra is not copied into release images.
deployments/
**/Containerfile*
**/compose*.yml
**/compose*.yaml
**/*.containerignore

# CI / lint / local tool configs
.github/
.golangci.yml
.markdownlint-cli2.yaml
.yamlfmt.yaml
.cspell.json
.commitlintrc.yaml
.editorconfig
.pre-commit-config.yaml
sonar-project.properties

# Node and legacy Python local caches that may appear during dev
node_modules/
__pycache__/
*.pyc
.venv/
