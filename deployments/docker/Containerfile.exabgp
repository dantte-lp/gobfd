# ExaBGP anycast integration image: the shared test/interop/exabgp runtime plus
# gobfd-exabgp-bridge, which ExaBGP starts through its process API. The ExaBGP
# source pin and Debian base must stay identical to test/interop/exabgp; the
# topology contract test enforces it.
FROM docker.io/library/golang:1.27.3-trixie@sha256:604106102d33b1084e37ca08adf98ac0813624ae8595bd0d7f3965ecebded09c AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w \
      -X github.com/dantte-lp/gobfd/internal/version.Version=${VERSION} \
      -X github.com/dantte-lp/gobfd/internal/version.GitCommit=${GIT_COMMIT} \
      -X github.com/dantte-lp/gobfd/internal/version.BuildDate=${BUILD_DATE}" \
    -o /bin/gobfd-exabgp-bridge ./cmd/gobfd-exabgp-bridge

FROM scratch AS source
# ExaBGP 5.0.13, peeled upstream tag commit and archive checksum.
ADD --checksum=sha256:dbf1f3789e28d5c06d123c154c1d4432da9378bbd251699bf7932c5b5f880302 \
    https://codeload.github.com/Exa-Networks/exabgp/tar.gz/edf249571174449f80c72d75eb6933dcabd67f92 /exabgp.tar.gz

# Debian 13 (trixie-slim); only the approved external peer uses system Python.
FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS production

ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/dantte-lp/gobfd" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="5.0.13" \
      org.opencontainers.image.licenses="BSD-3-Clause AND Apache-2.0" \
      org.opencontainers.image.title="GoBFD ExaBGP anycast integration" \
      org.opencontainers.image.description="Verified upstream ExaBGP on Debian system Python with gobfd-exabgp-bridge" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim" \
      org.opencontainers.image.base.digest="sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad" \
      io.gobfd.upstream.revision="edf249571174449f80c72d75eb6933dcabd67f92"

RUN ["apt-get", "update"]
RUN ["apt-get", "install", "-y", "--no-install-recommends", "python3", "iproute2", "dumb-init"]
RUN ["useradd", "-r", "exa"]
RUN ["install", "-d", "/opt/exabgp", "/etc/exabgp"]
RUN --mount=type=bind,from=source,target=/source \
    ["tar", "-xzf", "/source/exabgp.tar.gz", "-C", "/opt/exabgp", "--strip-components=1", "exabgp-edf249571174449f80c72d75eb6933dcabd67f92/src", "exabgp-edf249571174449f80c72d75eb6933dcabd67f92/LICENCE.txt"]
RUN ["mkfifo", "-m", "600", "/run/exabgp.in", "/run/exabgp.out"]
RUN ["chown", "exa", "/run/exabgp.in", "/run/exabgp.out"]

COPY --from=builder /bin/gobfd-exabgp-bridge /usr/local/bin/gobfd-exabgp-bridge

ENV PYTHONPATH=/opt/exabgp/src \
    exabgp_daemon_user=exa \
    exabgp_daemon_daemonize=false

# Consumers supply server/config arguments; no packaged default configuration.
ENTRYPOINT ["/usr/bin/dumb-init", "--", "python3", "-m", "exabgp"]
