# Scapy-based BFD protocol fuzzer for interoperability testing.
#
# Sends crafted/invalid BFD packets to GoBFD to verify robustness
# against malformed input per RFC 5880 Section 6.8.6 validation rules.
#
# Uses scapy.contrib.bfd for BFD packet construction.

FROM ghcr.io/astral-sh/uv:0.12.6@sha256:88bc6eb1ccd4b82efd0e1b530caffabddf50dc2bf612e66c14ea25b8ee8a4d3d AS uv

FROM docker.io/library/python:3.14.7-slim-trixie@sha256:83ff1d245a3d57d04152252d3ef9cb361494d0b3395abd65a5ebe91c401c8e83

COPY --from=uv /uv /uvx /usr/local/bin/
COPY pyproject.toml uv.lock .python-version /opt/gobfd-python/

WORKDIR /opt/gobfd-python
RUN uv sync --frozen --no-default-groups --group peer

COPY test/interop/scapy/bfd_fuzz.py /opt/bfd_fuzz.py

WORKDIR /opt

ENTRYPOINT ["uv", "run", "--project", "/opt/gobfd-python", "--frozen", "--no-default-groups", "--group", "peer", "--", "python", "/opt/bfd_fuzz.py"]
