FROM docker.io/library/golang:1.27.4-trixie@sha256:430985542100b871e108ccc00e8dcc5eef08ca14ee5825e98ebf563d8ffec4ee AS builder

ARG VCS_REF
ARG BUILD_DATE
ENV GOTOOLCHAIN=local GOMAXPROCS=2 GOMEMLIMIT=1500MiB GOFLAGS=-p=1
WORKDIR /src
COPY go.mod go.sum ./
RUN ["go", "mod", "download"]
RUN ["go", "mod", "verify"]
COPY . .
ENV CGO_ENABLED=0
RUN ["go", "build", "-trimpath", "-o", "/out/toolbootstrap", "./test/cmd/toolbootstrap"]
ENV GOFLAGS="-p=1 '-ldflags=-s -w -X github.com/dantte-lp/gobfd/internal/version.GitCommit=${VCS_REF} -X github.com/dantte-lp/gobfd/internal/version.BuildDate=${BUILD_DATE}'"
RUN ["go", "build", "-trimpath", "-o", "/bin/", "./cmd/gobfd", "./cmd/gobfdctl"]

# GoBGP v4.11.0 from the same immutable source pin as test/interop/gobgp;
# the topology contract test keeps both pins identical.
FROM docker.io/library/golang:1.27.4-trixie@sha256:430985542100b871e108ccc00e8dcc5eef08ca14ee5825e98ebf563d8ffec4ee AS gobgp
ADD --checksum=sha256:9706526b6fb76b8d6c4de379755819bed41be312e155f59e85baf55f9f3259a8 \
    https://codeload.github.com/osrg/gobgp/tar.gz/53ceb78fe284018ce83a92f3039198f0a86dc823 /tmp/gobgp.tar.gz
WORKDIR /src
RUN ["tar", "-xzf", "/tmp/gobgp.tar.gz", "--strip-components=1"]
ENV CGO_ENABLED=0 GOTOOLCHAIN=local \
    GOMAXPROCS=2 GOMEMLIMIT=1500MiB GOFLAGS=-p=2
RUN ["go", "mod", "download"]
RUN ["go", "mod", "verify"]
RUN ["go", "build", "-trimpath", "-mod=readonly", "-o", "/out/", "./cmd/gobgp", "./cmd/gobgpd"]

FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0

ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/dantte-lp/gobfd" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="dev" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="GoBFD Containerlab application peer" \
      org.opencontainers.image.description="GoBFD and GoBGP built from the repository-pinned sources" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim" \
      org.opencontainers.image.base.digest="sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0"

RUN --mount=type=bind,from=builder,source=/out/toolbootstrap,target=/bootstrap ["/bootstrap", "image-packages", "containerlab"]

COPY --from=builder /bin/gobfd /bin/gobfdctl /bin/
COPY --from=gobgp /out/gobgpd /out/gobgp /usr/local/bin/

EXPOSE 3784/udp 4784/udp 50051 50052 179

ENTRYPOINT ["/bin/gobfd"]
