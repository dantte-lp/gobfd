# Shared GoBGP v4.10.0 peer artifact; build with this directory as context.
# Go 1.27.3 on Debian 13 (trixie), matching the repository toolchain.
FROM docker.io/library/golang:1.27.3-trixie@sha256:604106102d33b1084e37ca08adf98ac0813624ae8595bd0d7f3965ecebded09c AS builder

# GoBGP v4.10.0, immutable upstream commit and archive checksum.
ADD --checksum=sha256:755448f0881b66e4a3795b443dd53825431cda1866d8b38e941e474d51714151 \
    https://codeload.github.com/osrg/gobgp/tar.gz/da824d99912e02124b53741245ee4186c381adcc /tmp/gobgp.tar.gz
WORKDIR /src
RUN ["tar", "-xzf", "/tmp/gobgp.tar.gz", "--strip-components=1"]
ENV CGO_ENABLED=0 GOTOOLCHAIN=local \
    GOMAXPROCS=2 GOMEMLIMIT=1500MiB GOFLAGS=-p=2
RUN ["go", "mod", "download"]
RUN ["go", "mod", "verify"]
RUN ["go", "build", "-trimpath", "-mod=readonly", "-o", "/out/", "./cmd/gobgp", "./cmd/gobgpd"]

# Debian 13 (trixie-slim), shared repository runtime base.
FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/dantte-lp/gobfd" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="4.10.0" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="GoBFD GoBGP interoperability peer" \
      org.opencontainers.image.description="GoBGP v4 peer built from verified upstream source" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim" \
      org.opencontainers.image.base.digest="sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f" \
      io.gobfd.upstream.revision="da824d99912e02124b53741245ee4186c381adcc"

COPY --from=builder /out/gobgp /out/gobgpd /usr/local/bin/
COPY --from=builder /src/LICENSE /usr/share/licenses/gobgp/LICENSE
CMD ["gobgpd"]
