FROM docker.io/library/oraclelinux:10-slim@sha256:965eb786602f98a4bc9ca449295d44468e5c8f2ee9175ae04c29f21bf1a9809d

RUN microdnf install -y ca-certificates shadow-utils \
    && microdnf clean all \
    && groupadd -r gobfd \
    && groupadd -r gobfd-admin \
    && useradd -r -g gobfd -G gobfd-admin -s /sbin/nologin gobfd \
    && install -d -o gobfd -g gobfd -m 0755 /run/gobfd

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/gobfd \
     ${TARGETPLATFORM}/gobfdctl \
     ${TARGETPLATFORM}/gobfd-haproxy-agent \
     ${TARGETPLATFORM}/gobfd-exabgp-bridge \
     /usr/local/bin/

USER gobfd:gobfd

EXPOSE 3784/udp 4784/udp

ENTRYPOINT ["/usr/local/bin/gobfd"]
