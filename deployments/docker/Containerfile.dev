ARG BUF_VERSION=v1.75.0
ARG PROTOC_GEN_GO_VERSION=v1.36.12
ARG PROTOC_GEN_CONNECT_GO_VERSION=v2.0.2
ARG BENCHSTAT_VERSION=v0.0.0-20261009192801-be2c69fb417e
ARG GOTESTSUM_VERSION=v1.13.0
ARG DOCKER_COMPOSE_VERSION=5.6.1

FROM docker.io/library/golang:1.27.3-trixie@sha256:604106102d33b1084e37ca08adf98ac0813624ae8595bd0d7f3965ecebded09c AS go-toolchain

FROM go-toolchain AS compose-provider

ARG DOCKER_COMPOSE_VERSION

WORKDIR /src
COPY go.mod go.sum ./
COPY test/cmd/toolbootstrap ./test/cmd/toolbootstrap
COPY test/internal/toolbootstrap ./test/internal/toolbootstrap
RUN go build -trimpath -o /out/toolbootstrap ./test/cmd/toolbootstrap \
    && /out/toolbootstrap compose \
        --install-dir /out/provider \
        --version "${DOCKER_COMPOSE_VERSION}"

FROM go-toolchain AS dev

ARG BUF_VERSION
ARG PROTOC_GEN_GO_VERSION
ARG PROTOC_GEN_CONNECT_GO_VERSION
ARG BENCHSTAT_VERSION
ARG GOTESTSUM_VERSION
ARG DOCKER_COMPOSE_VERSION

ENV GOFLAGS="-buildvcs=false" \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
	PODMAN_COMPOSE_PROVIDER=/usr/local/bin/docker-compose \
	PODMAN_COMPOSE_WARNING_LOGS=false \
	DOCKER_BUILDKIT=0 \
	DEBIAN_FRONTEND=noninteractive \
	PATH=/usr/local/go/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Build tools and certificates
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        tzdata \
        make \
        gcc \
        libc6-dev \
        bash \
        curl \
        jq \
        podman \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# Docker Compose v5 Go provider for `podman compose`.
COPY --from=compose-provider /out/provider/docker-compose /usr/local/bin/docker-compose

# Keep every Go-installed development command in one shared, discoverable path.
ENV GOBIN=/go/bin
ENV PATH=/go/bin:${PATH}

# buf CLI — protobuf toolchain
RUN go install github.com/bufbuild/buf/cmd/buf@${BUF_VERSION}

# protoc-gen-go — Go protobuf code generator
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION}

# protoc-gen-connect-go — ConnectRPC code generator
RUN go install connectrpc.com/connect/v2/cmd/protoc-gen-connect-go@${PROTOC_GEN_CONNECT_GO_VERSION}

# golangci-lint v2 — build through the isolated tools module so its analyzer
# closure cannot change the GoBFD runtime module's Minimal Version Selection.
WORKDIR /tmp/gobfd-tools
COPY tools/go.mod tools/go.sum ./
RUN go mod download \
    && go build -o /go/bin/golangci-lint \
        github.com/golangci/golangci-lint/v2/cmd/golangci-lint

# gopls keeps its upstream-compatible x/tools API in a separate patched graph.
WORKDIR /tmp/gobfd-gopls
COPY tools/gopls/go.mod tools/gopls/go.sum ./
RUN go mod download \
    && go build -o /go/bin/gopls golang.org/x/tools/gopls

WORKDIR /tmp/gobfd-tools
# Scanner builds inherit the shared tool module's security constraints.
RUN go build -o /go/bin/govulncheck golang.org/x/vuln/cmd/govulncheck

# osv-scanner — Google OSV vulnerability scanner (github.com/google/osv-scanner)
RUN go build -o /go/bin/osv-scanner github.com/google/osv-scanner/v2/cmd/osv-scanner

# benchstat — statistical comparison of Go benchmarks
RUN go install golang.org/x/perf/cmd/benchstat@${BENCHSTAT_VERSION}

# gotestsum — Go test runner with JUnit XML / JSON output
RUN go install gotest.tools/gotestsum@${GOTESTSUM_VERSION}

# Module cache warm-up happens on first `go mod download`
WORKDIR /app
VOLUME /app

# Keep container running for exec commands
CMD ["sleep", "infinity"]
