# BIRD3 container for BFD interoperability testing with GoBFD.
#
# Build the current stable BIRD 3.3.2 source at its immutable tag commit.

FROM docker.io/library/debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132 AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       autoconf \
       bison \
       build-essential \
       flex \
       libncurses-dev \
       libreadline-dev \
    && rm -rf /var/lib/apt/lists/*

ARG BIRD_COMMIT=e66773c42f115d80aaaef3b7246953b276a88065
ARG BIRD_SOURCE_SHA256=ad74ac8bc970f97a137f5df4e0c96777dfc7137b9773b1f95badec3d93e18754

WORKDIR /src

ADD --checksum=sha256:${BIRD_SOURCE_SHA256} \
    https://codeload.github.com/CZ-NIC/bird/tar.gz/${BIRD_COMMIT} \
    /tmp/bird.tar.gz

RUN tar -xzf /tmp/bird.tar.gz --strip-components=1 \
    && autoreconf \
    && ./configure --prefix=/usr --sysconfdir=/etc/bird --runstatedir=/run/bird \
    && make -j"$(nproc)" \
    && make DESTDIR=/out install

FROM docker.io/library/debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       iproute2 \
       libncurses6 \
       libreadline8t64 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/bird

COPY --from=builder /out/ /

ENTRYPOINT ["bird", "-f", "-c", "/etc/bird/bird.conf"]
