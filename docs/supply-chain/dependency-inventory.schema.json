{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dantte-lp/gobfd/docs/supply-chain/dependency-inventory.schema.json",
  "title": "GoBFD dependency inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "audited_at", "go_package_count", "evidence", "module_graphs", "components"],
  "properties": {
    "$schema": {"const": "https://github.com/dantte-lp/gobfd/docs/supply-chain/dependency-inventory.schema.json"},
    "schema_version": {"const": 2},
    "audited_at": {"type": "string", "format": "date-time"},
    "go_package_count": {"type": "integer", "minimum": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "module_graphs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/moduleGraph"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence_ids"],
      "properties": {
        "status": {"enum": ["verified", "stale", "unverified", "not-applicable"]},
        "value": {"type": "string"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["verified", "stale"]}}, "required": ["status"]},
        "then": {"required": ["value"], "properties": {"value": {"minLength": 1}, "evidence_ids": {"minItems": 1}}},
        "else": {"properties": {"evidence_ids": {"maxItems": 0}}}
      }]
    },
    "licenseException": {
      "type": "object", "additionalProperties": false, "required": ["owner", "review_by", "reason", "tracking"],
      "properties": {
        "owner": {"type": "string", "minLength": 1}, "review_by": {"type": "string", "format": "date"},
        "reason": {"type": "string", "minLength": 1}, "tracking": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "owner", "tracking"],
      "allOf": [{"if": {"properties": {"status": {"enum": ["deferred", "stale"]}}, "required": ["status"]}, "then": {"required": ["review_by"]}}],
      "properties": {
        "status": {"enum": ["adopted", "retained", "stale", "deferred", "removed"]},
        "reason": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
        "tracking": {"type": "string", "minLength": 1}, "review_by": {"type": "string", "format": "date"},
        "license_exception": {"$ref": "#/$defs/licenseException"}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_current", "upstream_current", "release_impact", "security", "license", "decision"],
      "properties": {
        "channel_current": {"$ref": "#/$defs/review"}, "upstream_current": {"$ref": "#/$defs/review"},
        "release_impact": {"$ref": "#/$defs/review"}, "security": {"$ref": "#/$defs/review"},
        "license": {"$ref": "#/$defs/review"}, "decision": {"$ref": "#/$defs/decision"}
      }
    },
    "repositoryState": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_archived", "artifact_available", "release_line_eol"],
      "properties": {
        "repository_archived": {"$ref": "#/$defs/review"}, "artifact_available": {"$ref": "#/$defs/review"},
        "release_line_eol": {"$ref": "#/$defs/review"}
      }
    },
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_repository": {"type": "string", "minLength": 1}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "purl": {"type": "string", "pattern": "^pkg:"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [{"required": ["source_repository"]}, {"required": ["purl"]}, {"required": ["digest"]}],
      "dependentRequired": {"source_commit": ["source_repository"]}
    },
    "evidenceTool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "subject", "review", "command_or_query", "tool", "observed_at", "result", "hash"],
      "properties": {
        "id": {"type": "string", "pattern": "^ev-[0-9a-f]{24}$"}, "source": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "review": {"enum": ["channel_current", "upstream_current", "release_impact", "security", "license", "repository_archived", "artifact_available", "release_line_eol"]},
        "command_or_query": {"type": "string", "minLength": 1}, "tool": {"$ref": "#/$defs/evidenceTool"},
        "observed_at": {"type": "string", "format": "date-time"}, "result": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "sourceLocation": {
      "type": "object", "additionalProperties": false, "required": ["path", "match"],
      "properties": {"path": {"type": "string", "minLength": 1}, "match": {"type": "string", "minLength": 1}}
    },
    "immutablePin": {
      "type": "object", "additionalProperties": false, "required": ["status", "kind", "value"],
      "properties": {
        "status": {"enum": ["verified", "mutable", "not-applicable"]},
        "kind": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "required": ["source_locations", "coordinates", "installed", "delivery_channel", "assessment", "repository_state", "immutable_pin"],
      "properties": {
        "source_locations": {"type": "array", "items": {"$ref": "#/$defs/sourceLocation"}}, "coordinates": {"$ref": "#/$defs/coordinates"},
        "baseline": {"type": "string"}, "installed": {"type": "string"}, "target": {"type": "string"},
        "delivery_channel": {"type": "string", "minLength": 1}, "assessment": {"$ref": "#/$defs/assessment"},
        "repository_state": {"$ref": "#/$defs/repositoryState"}, "immutable_pin": {"$ref": "#/$defs/immutablePin"}
      }
    },
    "module": {
      "allOf": [
        {"$ref": "#/$defs/record"},
        {"type": "object", "required": ["path", "version", "indirect"], "properties": {
          "path": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "indirect": {"type": "boolean"}
        }}
      ],
      "unevaluatedProperties": false
    },
    "moduleGraph": {
      "type": "object", "additionalProperties": false, "required": ["id", "manifest", "sum", "modules"],
      "properties": {
        "id": {"enum": ["runtime", "tools"]}, "manifest": {"type": "string", "minLength": 1},
        "sum": {"type": "string", "minLength": 1}, "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}
      }
    },
    "component": {
      "allOf": [
        {"$ref": "#/$defs/record"},
        {"type": "object", "required": ["id", "kind"], "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["github-action", "interop-daemon", "oci-image", "removed", "tool"]}
        }}
      ],
      "unevaluatedProperties": false
    }
  }
}
