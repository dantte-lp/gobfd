# Go BFD invalid-vector generator for interoperability testing.
#
# The legacy scapy service identifier is retained by Compose for compatibility,
# but the executable and its exact 18-group corpus are repository-owned Go.

FROM docker.io/library/golang:1.27.3-trixie@sha256:604106102d33b1084e37ca08adf98ac0813624ae8595bd0d7f3965ecebded09c AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY test/interop/scapy/*.go ./test/interop/scapy/
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/bfd-fuzz ./test/interop/scapy

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/dantte-lp/gobfd" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VCS_REF}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="GoBFD crafted interoperability peer" \
      org.opencontainers.image.description="Go-owned BFD invalid-vector and reload probes" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim" \
      org.opencontainers.image.base.digest="sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"

COPY --from=builder /out/bfd-fuzz /usr/local/bin/bfd-fuzz

ENTRYPOINT ["/usr/local/bin/bfd-fuzz"]
