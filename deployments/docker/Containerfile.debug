FROM docker.io/library/golang:1.27.4-trixie@sha256:430985542100b871e108ccc00e8dcc5eef08ca14ee5825e98ebf563d8ffec4ee AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN ["go", "mod", "download"]
RUN ["go", "mod", "verify"]
COPY . .
ENV CGO_ENABLED=0
RUN ["go", "build", "-trimpath", "-o", "/out/toolbootstrap", "./test/cmd/toolbootstrap"]

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ENV GOFLAGS="'-ldflags=-s -w -X github.com/dantte-lp/gobfd/internal/version.Version=${VERSION} -X github.com/dantte-lp/gobfd/internal/version.GitCommit=${GIT_COMMIT} -X github.com/dantte-lp/gobfd/internal/version.BuildDate=${BUILD_DATE}'"
RUN ["go", "build", "-trimpath", "-o", "/bin/", "./cmd/gobfd", "./cmd/gobfdctl", "./cmd/gobfd-haproxy-agent", "./cmd/gobfd-exabgp-bridge"]

ARG GOBFD_IMAGE_RUN=""
ARG GOBFD_IMAGE_TEST=""
LABEL io.gobfd.stage-run="${GOBFD_IMAGE_RUN}" \
      io.gobfd.stage-test="${GOBFD_IMAGE_TEST}"

FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS debug

# Install networking debug tools useful for BFD troubleshooting:
#   tcpdump   - capture BFD packets (UDP 3784/4784)
#   iproute2  - ip link, ip addr, ip route inspection
#   dnsutils   - dig/nslookup for DNS debugging
#   strace    - system call tracing for socket issues
RUN --mount=type=bind,from=builder,source=/out/toolbootstrap,target=/bootstrap ["/bootstrap", "image-packages", "debug"]

COPY --from=builder /bin/gobfd /bin/gobfdctl /bin/gobfd-haproxy-agent /bin/gobfd-exabgp-bridge /usr/local/bin/

EXPOSE 3784/udp 4784/udp

ENTRYPOINT ["/usr/local/bin/gobfd"]
