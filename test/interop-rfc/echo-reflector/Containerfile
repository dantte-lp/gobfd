# Echo reflector for RFC 9747 BFD echo interop testing.
# Listens on UDP 3785 and reflects packets back to the sender.
FROM docker.io/library/golang:1.27.4-trixie@sha256:430985542100b871e108ccc00e8dcc5eef08ca14ee5825e98ebf563d8ffec4ee AS build
WORKDIR /src
RUN go mod init echo-reflector
COPY main.go .
RUN CGO_ENABLED=0 go build -o /echo-reflector .

FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
COPY --from=build /echo-reflector /usr/local/bin/echo-reflector
EXPOSE 3785/udp
ENTRYPOINT ["echo-reflector"]
